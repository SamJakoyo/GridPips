rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Security Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'samjakoyo26@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasActiveParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;
    }

    // Validation Blueprints
    function isValidTraderRoot(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role == 'user' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTraderPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'exnessAccountId', 'preferredModel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'exnessAccountId', 'preferredModel', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.exnessAccountId is string && data.exnessAccountId.size() <= 40 &&
        data.preferredModel in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite', 'gemini-4-argon', 'gemini-4-carbon'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedIctSetup(data, userId) {
      return data.keys().hasAll(['uid', 'symbol', 'timeframe', 'bias', 'entryZone', 'stopLoss', 'tp1', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'symbol', 'timeframe', 'bias', 'entryZone', 'stopLoss', 'tp1', 'notes', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.symbol is string && data.symbol.size() >= 2 && data.symbol.size() <= 16 &&
        data.timeframe in ['M15', 'H1', 'H4', 'D1'] &&
        data.bias in ['Bullish', 'Bearish'] &&
        data.entryZone is string && data.entryZone.size() >= 1 && data.entryZone.size() <= 64 &&
        data.stopLoss is number &&
        data.tp1 is number &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMediaCreationRecord(data, userId) {
      return data.keys().hasAll(['uid', 'kind', 'model', 'prompt', 'aspectRatio', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'kind', 'model', 'prompt', 'aspectRatio', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.kind in ['image', 'video'] &&
        data.model is string && data.model.size() >= 3 && data.model.size() <= 64 &&
        data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 600 &&
        data.aspectRatio is string && data.aspectRatio.size() >= 2 && data.aspectRatio.size() <= 12 &&
        data.createdAt is timestamp;
    }

    // Root Trader Workspace Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidTraderRoot(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidTraderRoot(incoming(), userId) && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) &&
            incoming().uid == existing().uid &&
            incoming().role == existing().role &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII & Settings
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidTraderPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasActiveParentUser(userId);
        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidTraderPrivateInfo(incoming(), userId) && (
            isAdmin() ||
            (
              isOwner(userId) &&
              hasActiveParentUser(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['exnessAccountId', 'preferredModel', 'updatedAt']) &&
              incoming().uid == existing().uid &&
              incoming().email == existing().email &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time
            )
          );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }

      // Saved ICT Market Analyzer Setups
      match /savedSetups/{setupId} {
        allow get: if isValidId(userId) && isValidId(setupId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(setupId) &&
          isValidSavedIctSetup(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasActiveParentUser(userId);
        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(setupId) &&
          isValidSavedIctSetup(incoming(), userId) && (
            isAdmin() ||
            (
              isOwner(userId) &&
              hasActiveParentUser(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']) &&
              incoming().uid == existing().uid &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time
            )
          );
        allow delete: if isValidId(userId) && isValidId(setupId) && (isOwner(userId) || isAdmin());
      }

      // AI Image & Video Creation History Metadata
      match /mediaCreations/{creationId} {
        allow get: if isValidId(userId) && isValidId(creationId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(creationId) &&
          isValidMediaCreationRecord(incoming(), userId) &&
          incoming().createdAt == request.time &&
          hasActiveParentUser(userId);
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(creationId) && (isOwner(userId) || isAdmin());
      }
    }

    // Server-managed Admin Role Records
    match /admins/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
