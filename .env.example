# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (or your Vercel deployment URL).
APP_URL="MY_APP_URL"

# Security & Session Signing (set in Vercel Project Settings -> Environment Variables)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"

# Optional Live MegaPay M-Pesa Till Integration (Kenya KES STK Push)
MEGAPAY_API_KEY=""
MEGAPAY_EMAIL=""

# Cloud SQL PostgreSQL Connection (set in Vercel Environment Variables for persistent playbooks)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Supabase Connection (Project Settings -> API)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

